@startuml
left to right direction

actor "Исследователь" as Researcher
actor "Администратор" as Admin

rectangle "Мониторинг популяции\nдиких животных" {
  usecase "Авторизоваться" as UC1
  usecase "Добавить наблюдение" as UC2
  usecase "Просматривать\nнаблюдения" as UC3
  usecase "Просматривать\nаналитические данные" as UC4
  usecase "Управлять\nсправочником видов" as UC5
  usecase "Управлять\nлокациями" as UC6
  usecase "Проверять\nкорректность данных" as UC7
  usecase "Просматривать\nотчеты" as UC8
}

Researcher --> UC1
Researcher --> UC2
Researcher --> UC3
Researcher --> UC4

Admin --> UC1
Admin --> UC3
Admin --> UC5
Admin --> UC6
Admin --> UC7
Admin --> UC8
@enduml