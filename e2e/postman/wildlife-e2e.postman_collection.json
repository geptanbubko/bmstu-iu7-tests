{
  "info": {
    "name": "Wildlife Monitoring — E2E-сценарий",
    "description": "Повторяет tests/e2e/population_monitoring_scenario_e2e.py. Запускать по порядку (Run collection). baseUrl — адрес стенда (порт: ci/stand.sh up).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "tag", "value": "postman" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get('runTag')) { pm.collectionVariables.set('runTag', pm.collectionVariables.get('tag') + '-' + Date.now()); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/health" },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('стенд жив', () => pm.response.to.have.status(200));"
      ] } }]
    },
    {
      "name": "02 Сессия администратора",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/session",
        "body": { "mode": "raw", "raw": "{\"role\": \"admin\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('201', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('adminToken', pm.response.json().token);"
      ] } }]
    },
    {
      "name": "03 Сессия исследователя",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/session",
        "body": { "mode": "raw", "raw": "{\"role\": \"researcher\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.collectionVariables.set('researcherToken', pm.response.json().token);"
      ] } }]
    },
    {
      "name": "04 Добавить вид",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/species",
        "body": { "mode": "raw", "raw": "{\"scientific_name\": \"Vulpes lagopus {{runTag}}\", \"common_name\": \"Песец\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('201', () => pm.response.to.have.status(201));",
        "pm.collectionVariables.set('speciesId', pm.response.json().id);"
      ] } }]
    },
    {
      "name": "05 Добавить локацию",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/locations",
        "body": { "mode": "raw", "raw": "{\"name\": \"Хибины {{runTag}}\", \"region\": \"Мурманская область\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.collectionVariables.set('locationId', pm.response.json().id);"
      ] } }]
    },
    {
      "name": "06 Добавить исследователя",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/researchers",
        "body": { "mode": "raw", "raw": "{\"full_name\": \"Тестов Т.Т. {{runTag}}\", \"organization\": \"ИУ7\"}" }
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.collectionVariables.set('researcherId', pm.response.json().id);"
      ] } }]
    },
    {
      "name": "07 Наблюдения (5 шт.)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{researcherToken}}" }
        ],
        "url": "{{baseUrl}}/api/v1/observations",
        "body": { "mode": "raw", "raw": "{\"species_id\": {{speciesId}}, \"location_id\": {{locationId}}, \"researcher_id\": {{researcherId}}, \"observation_date\": \"{{obsDate}}\", \"individuals_count\": {{obsCount}}, \"notes\": \"{{runTag}}\"}" }
      },
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "const survey = [['2025-04-10',3],['2025-05-10',5],['2025-06-10',6],['2025-07-10',8],['2025-08-10',9]];",
          "const i = Number(pm.collectionVariables.get('obsIndex') || 0);",
          "pm.collectionVariables.set('obsDate', survey[i][0]);",
          "pm.collectionVariables.set('obsCount', survey[i][1]);"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('201', () => pm.response.to.have.status(201));",
          "const i = Number(pm.collectionVariables.get('obsIndex') || 0) + 1;",
          "if (i < 5) { pm.collectionVariables.set('obsIndex', i); pm.execution.setNextRequest('07 Наблюдения (5 шт.)'); }",
          "else { pm.collectionVariables.set('obsIndex', 0); }"
        ] } }
      ]
    },
    {
      "name": "08 Журнал наблюдений",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{researcherToken}}" }],
        "url": "{{baseUrl}}/api/v1/observations"
      }
    },
    {
      "name": "09 Анализ динамики",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{researcherToken}}" }],
        "url": "{{baseUrl}}/api/v1/analytics/population?species_id={{speciesId}}&date_from=2025-01-01&date_to=2025-12-31&location_id={{locationId}}"
      },
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('тренд построен', () => pm.expect(pm.response.json().has_trend).to.eql(true));"
      ] } }]
    },
    {
      "name": "10 Завершить сессии",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": "{{baseUrl}}/api/v1/sessions"
      }
    }
  ]
}
